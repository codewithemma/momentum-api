# Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL connection used by Prisma and the application.
DATABASE_URL=postgresql://postgres:password@localhost:5432/momentum?schema=public

# Redis connection used for refresh-token locks and cached refresh results.
REDIS_URL=redis://localhost:6379

# Generate private random values for local and production environments.
JWT_SECRET_KEY=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-random-cron-secret

# Google OAuth client ID. Both names are read by the backend:
# AUTH_GOOGLE_ID initializes the token verifier and GOOGLE_CLIENT_ID is the
# audience checked during verification.
AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3001

# Used to build dashboard links in follow-up reminder emails.
FRONTEND_URL=http://localhost:3001

# Development email delivery (used when NODE_ENV is not production).
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your-mailtrap-user
MAILTRAP_PASSWORD=your-mailtrap-password

# Production email delivery (used when NODE_ENV=production).
RESEND_API_KEY=re_your_developer_key
